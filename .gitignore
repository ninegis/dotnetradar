# ==============================================
# 通用忽略规则
# ==============================================
# 操作系统生成文件
.DS_Store                # macOS
Thumbs.db                # Windows
desktop.ini              # Windows
*.swp                    # Vim 临时文件
*.swo                    # Vim 临时文件
*~                       # 临时文件

# 编辑器/IDE 配置（按需保留必要配置）
.idea/                   # IntelliJ 系列
.vscode/*
!.vscode/extensions.json  # 保留扩展配置
!.vscode/settings.json    # 保留基础设置
!.vscode/tasks.json       # 保留任务配置
!.vscode/launch.json      # 保留调试配置
*.suo                    # Visual Studio 解决方案用户选项
*.user                   # Visual Studio 用户文件
*.sln.docstates          # Visual Studio 解决方案状态文件

# ==============================================
# C# (.NET) 项目忽略规则
# ==============================================
# 构建输出目录
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core 相关
project.lock.json
project.fragment.lock.json
artifacts/
global.json

# NuGet 包
*.nupkg
*.snupkg
.nuget/
packages/                # 旧式 NuGet 包目录

# 测试相关
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage/                # 代码覆盖率报告

# MSBuild 日志
*.binlog

# ASP.NET 相关
ScaffoldingReadMe.txt
wwwroot/lib/             # 前端库（若通过 NuGet 管理）

# ==============================================
# Vue 项目忽略规则
# ==============================================
# 依赖目录
node_modules/
.pnp/
.pnp.js

# 编译输出
dist/
Deploy/
dist-ssr/
*.local

# 缓存与日志
.cache/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量（通常包含敏感信息）
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Vue CLI 相关
vue.config.js.*

# 其他工具
.turbo/
.next/                   # 若使用 Nuxt.js
.output/                 # 若使用 Nuxt 3