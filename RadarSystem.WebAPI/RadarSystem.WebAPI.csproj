<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:8080</SpaProxyServerUrl>
    <NoWarn>NU1701;CS1998;CS8625</NoWarn>
    <!-- 启用XML文档生成用于Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadarSystem.Core\RadarSystem.Core.csproj" />
    <ProjectReference Include="..\RadarSystem.Data\RadarSystem.Data.csproj" />
    <ProjectReference Include="..\RadarSystem.ImageAnalysis\RadarSystem.ImageAnalysis.csproj" />
    <ProjectReference Include="..\RadarSystem.Alarm\RadarSystem.Alarm.csproj" />
    <ProjectReference Include="..\RadarSystem.Communication\RadarSystem.Communication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 前端源文件 -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And !Exists('wwwroot\index.html') And Exists('$(SpaRoot)package.json')">
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" ContinueOnError="true" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" ContinueOnError="true" />
  </Target>

  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(SpaRoot)package.json')">
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" ContinueOnError="true" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" ContinueOnError="true" />
    
    <ItemGroup>
      <DistFiles Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

