  "端口监测命令": {
    "Windows": {
      "检查所有雷达端口": "netstat -ano | findstr \"LISTENING\" | findstr \"1030 1060 10305 11125 11129 11135\"",
      "检查所有传感器端口": "netstat -ano | findstr \"LISTENING\" | findstr \"11109 11111 11126 11131\"",
      "检查所有控制端口": "netstat -ano | findstr \"LISTENING\" | findstr \"11114 11115 11127\"",
      "检查Web服务端口": "netstat -ano | findstr \"LISTENING\" | findstr \"6098 8099\"",
      "检查所有端口": "netstat -ano | findstr \"LISTENING\" | findstr \"1030 1060 6098 8099 10305 11\"",
      "检查特定端口": "netstat -ano | findstr \":1030\""
    },
    "Linux": {
      "检查所有端口": "netstat -tuln | grep -E ':(1030|1060|6098|8099|10305|11)'"
    }
  },
  
  "控制台输出配置": {
    "启用详细输出的设备": [
      "圆弧雷达(1030)",
      "建筑物雷达(1060)",
      "建筑物2D雷达(11135)",
      "MIMO Lite雷达(10305)",
      "MIMO雷达(11125)",
      "MIMO通用(11129)"
    ],
    "输出格式": {
      "数据接收": {
        "时间": "yyyy-MM-dd HH:mm:ss.fff",
        "端口": "整数",
        "FactoryId": "字符串（设备唯一标识）",
        "命令代码": "0xXXXX",
        "数据长度": "字节数",
        "原始数据": "十六进制（前200字符）"
      },
      "文件保存": {
        "时间": "yyyy-MM-dd HH:mm:ss.fff",
        "设备ID": "内部ID",
        "FactoryId": "出厂ID",
        "数据类型": "类型名称",
        "文件路径": "完整路径",
        "文件大小": "KB",
        "状态": "✅成功 或 ❌失败"
      }
    }
  },
  
  "数据存储路径": {
    "基础路径": "../../data/project/",
    "结构": "{ProjectId}/radar/{DeviceId}/{DataType}/{yyyyMMdd}/HHmmss.dat",
    "示例": {
      "圆弧雷达": "data/project/PROJECT001/radar/20/00_20251102183000.dat",
      "建筑物雷达": "data/project/PROJECT001/radar/BUILDING_001/scan_20251102183000.dat"
    }
  },
  
  "FactoryId映射规则": {
    "说明": "FactoryId（出厂ID）是设备的唯一物理标识，用于匹配数据包中的SlaveId",
    "映射流程": [
      "1. 应用启动时从API加载设备列表",
      "2. 提取每个设备的FactoryId和DeviceId",
      "3. 建立映射表: FactoryId → DeviceId",
      "4. 接收数据时通过SlaveId查找对应的DeviceId",
      "5. 使用DeviceId保存文件和记录日志"
    ],
    "示例映射": {
      "20": "RADAR_001",
      "21": "RADAR_002",
      "BUILDING001": "BUILDING_RADAR_001"
    },
    "未映射处理": "如果未找到映射，直接使用FactoryId作为DeviceId"
  }
}

