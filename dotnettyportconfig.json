  "startupCheckConfig": {
    "checkIntervalSeconds": 2,
    "maxRetries": 15,
    "timeoutSeconds": 30,
    "onFailureAction": "LogAndContinue",
    "successCriteria": "PortInListeningState",
    "comment": "启动检查配置：检查间隔2秒，最多重试15次，超时30秒"
  },
  
  "factoryIdMapping": {
    "enabled": true,
    "apiEndpoint": "http://localhost:8099/api/Device",
    "loadDelaySeconds": 15,
    "retryOnFailure": true,
    "fallbackBehavior": "UseFactoryIdAsDeviceId",
    "comment": "FactoryId自动映射配置：从API加载设备列表，延迟15秒，失败时使用FactoryId作为DeviceId"
  },
  
  "consoleOutputConfig": {
    "enabledDevices": ["ArcRadar", "MimoLiteRadar", "BuildingRadar", "Building2DRadar", "MimoRadar", "Mimo"],
    "showHexData": true,
    "maxHexDisplayLength": 200,
    "showFullDataUnder": 1000,
    "timestampFormat": "yyyy-MM-dd HH:mm:ss.fff",
    "comment": "控制台输出配置：仅雷达设备显示详细输出，十六进制数据最多显示200字符"
  },
  
  "fieldDescriptions": {
    "name": "设备标识符（英文）",
    "displayName": "设备显示名称（中文）",
    "port": "TCP监听端口号",
    "enabled": "是否启用该设备服务器",
    "startupCheck": "是否在启动后检查端口监听状态",
    "criticalMonitoring": "是否为重点监测设备",
    "priority": "启动优先级（1最高，6最低）",
    "protocol": "通信协议类型",
    "handlerClass": "对应的Netty服务器Handler类名",
    "dataTypes": "支持的数据类型列表",
    "useFactoryId": "是否使用FactoryId进行设备映射",
    "consoleOutput": "是否输出详细的控制台日志",
    "comment": "备注说明（中文）"
  }
